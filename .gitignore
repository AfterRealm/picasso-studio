# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
.python-version
build/
dist/

# Test sessions on disk — runtime state, never commit
scripts/studio/sessions_data/
picasso_studio/sessions_data/*
!picasso_studio/sessions_data/.gitkeep

# Pre-rewrite backup of static frontend (kept locally for diff reference)
scripts/studio/static/_backup-*/

# Eval runs
evals/runs/

# Editor noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local secrets (defensive — token actually lives at ~/.picasso_studio/token)
*.token
.env
.env.local
